# Copie ce fichier en `.env.local` et remplis les valeurs.
# Sans ces variables, le site démarre en MODE DÉMO (équipe fictive, données en mémoire).

# Supabase > Project Settings > Data API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase > Project Settings > API Keys
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Clé secrète : uniquement côté serveur, ne jamais la partager ni la committer.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Code à donner aux nouveaux membres pour créer leur compte.
# 12 caractères minimum (sinon les inscriptions restent fermées) ; une phrase longue est idéale.
TEAM_INVITE_CODE=change-moi-par-un-code-long-et-unique

# Uniquement pour mettre en ligne une démo SANS Supabase (données fictives).
# DEMO_MODE=1
