# Copie ce fichier en `.env.local` et remplis les valeurs.
# Sans ces variables, le site démarre en MODE DÉMO (équipe fictive, données en mémoire).

# Supabase > Project Settings > Data API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase > Project Settings > API Keys > clé secrète.
# Uniquement côté serveur : ne jamais la partager ni la committer.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Signe les cookies de session (32 caractères minimum, aléatoires).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Le changer déconnecte tout le monde.
SESSION_SECRET=remplace-moi-par-une-valeur-aleatoire-de-32-caracteres-ou-plus

# Uniquement pour mettre en ligne une démo SANS Supabase (données fictives).
# DEMO_MODE=1
