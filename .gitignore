# ── Secrets & données perso (ne JAMAIS committer) ──────────────
.claude/.credentials.json
.claude/.credentials
**/.credentials*
*.env
.env
*.pem
*_secret*
*token*.json

# ── Données de session / machine-spécifiques ───────────────────
.claude/sessions/
.claude-flow/sessions/
.claude/session-data/
.claude/session-env/
.claude/projects/
.claude/history.jsonl
.claude/tasks/
.claude/state/
.claude/telemetry/
.claude/metrics/
.claude/backups/
.claude/cache/
.claude/chrome/
.claude/ide/
.claude/shell-snapshots/
.claude/file-history/
.claude/plans/
.claude/downloads/
.claude/*.log
.claude/.last-*
.claude/.proven-config-version

# ── Plugins : état LOCAL d'installation (chemins machine-spécifiques) ──
# On ne versionne AUCUN fichier d'état de plugin : il contient des chemins
# absolus /Users/<toi>/... et est régénéré par `claude plugin install`.
.claude/plugins/

# ── Divers OS ──────────────────────────────────────────────────
.DS_Store
